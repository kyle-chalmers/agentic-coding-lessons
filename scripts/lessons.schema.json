{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kyle-chalmers/agentic-coding-lessons/scripts/lessons.schema.json",
  "title": "agentic-coding-lessons lessons.json",
  "type": "object",
  "required": ["version", "themes", "lessons"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "themes": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["title", "tier", "scope", "intro"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 3},
          "tier": {"enum": ["agentic-practice", "engineering"]},
          "scope": {"type": "string", "minLength": 10},
          "intro": {"type": "string", "minLength": 20}
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lesson"}
    }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "required": ["id", "title", "tier", "theme", "symptom", "rule", "why", "confidence",
                   "confidence_note", "first_seen", "applies_to", "tool_scope", "related"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^L-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 10, "maxLength": 140},
        "tier": {"enum": ["agentic-practice", "engineering"]},
        "theme": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "symptom": {"type": "string", "minLength": 20},
        "rule": {"type": "string", "minLength": 15},
        "why": {"type": "string", "minLength": 20},
        "confidence": {"enum": ["high", "medium", "low"]},
        "confidence_note": {"type": "string", "minLength": 5},
        "first_seen": {"type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"},
        "applies_to": {"type": "string", "minLength": 5},
        "last_verified": {"type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"},
        "tool_scope": {"enum": ["agent-agnostic", "claude-code-primary", "claude-code-specific"]},
        "other_agents": {"type": "string", "minLength": 10},
        "related": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "object", "required": ["label", "url"], "additionalProperties": false,
               "properties": {"label": {"type": "string", "minLength": 2},
                              "url": {"type": "string", "pattern": "^https://"}}},
              {"type": "object", "required": ["lesson"], "additionalProperties": false,
               "properties": {"lesson": {"type": "string", "pattern": "^L-[0-9]{3}$"}}}
            ]
          }
        },
        "adds_beyond_docs": {"type": "string", "minLength": 15},
        "digest_rank": {"type": "integer", "minimum": 1, "maximum": 20},
        "digest_blurb": {"type": "string", "minLength": 20, "maxLength": 240}
      },
      "dependentRequired": {"digest_rank": ["digest_blurb"], "digest_blurb": ["digest_rank"]},
      "allOf": [
        {
          "if": {"properties": {"tool_scope": {"const": "agent-agnostic"}}},
          "then": {"not": {"required": ["other_agents"]}}
        },
        {
          "if": {"properties": {"related": {"contains": {"required": ["url"]}}}},
          "then": {"required": ["adds_beyond_docs"]}
        }
      ]
    }
  }
}
